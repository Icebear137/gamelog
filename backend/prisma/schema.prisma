generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  username   String   @unique
  email      String   @unique
  password   String
  bio        String?
  avatar     String?
  banner     String?
  steamId    String?
  discordTag String?
  isPrivate  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  emailNotifications     Boolean             @default(true)
  isAdmin                Boolean             @default(false)
  notifFollow            Boolean             @default(true)
  notifLike              Boolean             @default(true)
  notifComment           Boolean             @default(true)
  notifMention           Boolean             @default(true)
  lastDigestAt           DateTime?
  lastSeen               DateTime?

  gameEntries            GameEntry[]
  activities             Activity[]
  likes                  Like[]
  comments               Comment[]
  following              Follow[]            @relation("Follower")
  followers              Follow[]            @relation("Following")
  notificationsReceived  Notification[]      @relation("NotifRecipient")
  notificationsSent      Notification[]      @relation("NotifActor")
  gameLists              GameList[]
  gameListLikes          GameListLike[]
  gameListComments       GameListComment[]
  reviewLikes            ReviewLike[]
  gameTagVotes           GameTagVote[]
  reports                Report[]
  playthroughs           GamePlaythrough[]
  clubsCreated           GameClub[]          @relation("ClubCreator")
  clubMemberships        GameClubMember[]
  clubPosts              GameClubPost[]
  clubJoinRequests       GameClubJoinRequest[]
  clubComments           GameClubComment[]
  clubPostLikes          GameClubPostLike[]
  clubPostReactions      GameClubPostReaction[]
  yearlyChallenges       YearlyChallenge[]
  achievements           UserAchievement[]
  conversationParticipants ConversationParticipant[]
  messagesSent           Message[]
  messageReactions       MessageReaction[]
  gameNightRsvps         GameNightRsvp[]
  gameNightsCreated      GameNight[]           @relation("GameNightCreator")
  conversationNicknames  ConversationNickname[]
  pollVotes              PollVote[]
  posts                  Post[]
  postLikes              PostLike[]
  postComments           PostComment[]
}

model Game {
  id          String   @id @default(cuid())
  rawgId      Int      @unique
  name        String
  slug        String   @unique
  coverImage  String?
  genres      String   @default("[]")
  releaseYear Int?
  rawgRating  Float?
  description String?
  platforms   String   @default("[]")
  developers  String   @default("[]")
  publishers  String   @default("[]")
  website     String?
  metacritic  Int?
  esrbRating  String?
  avgPlaytime Int?
  createdAt   DateTime @default(now())

  entries     GameEntry[]
  listEntries GameListEntry[]
  messages    Message[]
  gameNights  GameNight[]
  tags        GameTag[]
  clubs       GameClub[]
}

model GameEntry {
  id        String     @id @default(cuid())
  userId    String
  gameId    String
  status    String
  rating    Int?
  review    String?
  playtime  Int?
  platform  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  game         Game          @relation(fields: [gameId], references: [id])
  activities   Activity[]
  reviewLikes  ReviewLike[]
  playthroughs GamePlaythrough[]

  @@unique([userId, gameId])
}

model Activity {
  id          String   @id @default(cuid())
  userId      String
  gameEntryId String
  type        String
  createdAt   DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameEntry     GameEntry      @relation(fields: [gameEntryId], references: [id], onDelete: Cascade)
  likes         Like[]
  comments      Comment[]
  notifications Notification[]
}

model Like {
  id         String   @id @default(cuid())
  userId     String
  activityId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
}

model ReviewLike {
  id        String   @id @default(cuid())
  userId    String
  entryId   String
  createdAt DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry GameEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId])
}

// ── Game Clubs ────────────────────────────────────────────────────────────────

model GameClub {
  id            String   @id @default(cuid())
  name          String
  description   String?
  avatar        String?
  gameId        String?
  genre         String?  // genre tag e.g. "RPG", "Action"
  isPrivate     Boolean  @default(false)
  createdBy     String
  pinnedPostId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creator      User                  @relation("ClubCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  game         Game?                 @relation(fields: [gameId], references: [id], onDelete: SetNull)
  members      GameClubMember[]
  posts        GameClubPost[]
  pinnedPost   GameClubPost?         @relation("PinnedPost", fields: [pinnedPostId], references: [id], onDelete: SetNull)
  joinRequests GameClubJoinRequest[]
  joinQuestions GameClubJoinQuestion[]
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model GameClubJoinQuestion {
  id        String   @id @default(cuid())
  clubId    String
  question  String
  required  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  club    GameClub                    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  answers GameClubJoinRequestAnswer[]
}

model GameClubJoinRequest {
  id             String            @id @default(cuid())
  clubId         String
  userId         String
  status         JoinRequestStatus @default(PENDING)
  rejectionNote  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  club    GameClub                    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user    User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers GameClubJoinRequestAnswer[]

  @@unique([clubId, userId])
}

model GameClubJoinRequestAnswer {
  id         String @id @default(cuid())
  requestId  String
  questionId String
  answer     String

  request  GameClubJoinRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  question GameClubJoinQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model GameClubMember {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  role      String   @default("member") // "admin" | "member"
  isBanned  Boolean  @default(false)
  joinedAt  DateTime @default(now())

  club GameClub @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
}

model GameClubPost {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club          GameClub              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments      GameClubComment[]
  likes         GameClubPostLike[]
  reactions     GameClubPostReaction[]
  pinnedInClubs GameClub[]            @relation("PinnedPost")
}

model GameClubComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  post GameClubPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GameClubPostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post GameClubPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model GameClubPostReaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  post GameClubPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
}

model GamePlaythrough {
  id          String   @id @default(cuid())
  userId      String
  entryId     String
  playtime    Int?     // hours for this run
  platform    String?
  completedAt DateTime?
  note        String?
  createdAt   DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry GameEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

model GameTag {
  id        String   @id @default(cuid())
  gameId    String
  tag       String
  createdAt DateTime @default(now())

  game  Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  votes GameTagVote[]

  @@unique([gameId, tag])
}

model GameTagVote {
  id        String   @id @default(cuid())
  tagId     String
  userId    String
  createdAt DateTime @default(now())

  gameTag GameTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tagId, userId])
}

model Comment {
  id         String   @id @default(cuid())
  userId     String
  activityId String
  body       String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model GameList {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries  GameListEntry[]
  likes    GameListLike[]
  comments GameListComment[]
}

model GameListEntry {
  id      String   @id @default(cuid())
  listId  String
  gameId  String
  addedAt DateTime @default(now())

  list GameList @relation(fields: [listId], references: [id], onDelete: Cascade)
  game Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([listId, gameId])
}

model GameListLike {
  id        String   @id @default(cuid())
  userId    String
  listId    String
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  list GameList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
}

model GameListComment {
  id        String   @id @default(cuid())
  userId    String
  listId    String
  body      String
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  list GameList @relation(fields: [listId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  actorId     String
  type        String   // FOLLOW | LIKE | COMMENT | MENTION | CLUB_POST
  activityId  String?
  clubPostId  String?
  clubId      String?
  clubName    String?  // denormalized for display without extra join
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user     User      @relation("NotifRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor    User      @relation("NotifActor", fields: [actorId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([userId, read])
}

model YearlyChallenge {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  goal      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
}

model UserAchievement {
  id       String   @id @default(cuid())
  userId   String
  type     String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model Conversation {
  id              String   @id @default(cuid())
  isGroup         Boolean  @default(false)
  name            String?
  avatar          String?
  pinnedMessageId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participants  ConversationParticipant[]
  messages      Message[]
  gameNights    GameNight[]
  nicknames     ConversationNickname[]
  pinnedMessage Message?                  @relation("PinnedMessage", fields: [pinnedMessageId], references: [id], onDelete: SetNull)
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  role           String    @default("member") // "admin" | "member"
  lastReadAt     DateTime  @default(now())
  mutedUntil     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model ConversationNickname {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  nickname       String
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model GameNight {
  id             String   @id @default(cuid())
  conversationId String
  createdBy      String
  messageId      String   @unique
  title          String
  gameId         String?
  scheduledAt    DateTime
  platform       String?
  note           String?
  createdAt      DateTime @default(now())

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  creator      User            @relation("GameNightCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  game         Game?           @relation(fields: [gameId], references: [id], onDelete: SetNull)
  message      Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  rsvps        GameNightRsvp[]
}

model GameNightRsvp {
  id          String   @id @default(cuid())
  gameNightId String
  userId      String
  status      String   // "going" | "maybe" | "no"
  updatedAt   DateTime @updatedAt

  gameNight GameNight @relation(fields: [gameNightId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameNightId, userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  imageUrl       String?
  imageUrls      String?   // JSON array of URLs for multi-image messages
  audioUrl       String?
  audioDuration  Int?      // seconds
  fileUrl        String?
  fileName       String?
  fileSize       Int?      // bytes
  fileType       String?   // MIME type
  replyToId      String?
  gameId         String?
  isForwarded    Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]         @relation("MessageReplies")
  reactions            MessageReaction[]
  game                 Game?             @relation(fields: [gameId], references: [id], onDelete: SetNull)
  pinnedInConversation Conversation[]    @relation("PinnedMessage")
  poll                 Poll?
  gameNight            GameNight?
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Poll {
  id             String   @id @default(cuid())
  messageId      String   @unique
  conversationId String
  question       String
  allowMultiple  Boolean   @default(false)
  anonymous      Boolean   @default(false)
  endsAt         DateTime?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())

  message Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  text   String
  order  Int

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, optionId, userId])
}

// ── Report / Moderation ───────────────────────────────────────────────────────

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  type        String   // REVIEW | ACTIVITY_COMMENT | LIST_COMMENT | CLUB_POST | CLUB_COMMENT
  targetId    String   // ID of the reported content
  reason      String   // SPAM | INAPPROPRIATE | HARASSMENT | MISINFORMATION | OTHER
  description String?  // optional details from reporter
  status      String   @default("PENDING") // PENDING | REVIEWED | DISMISSED
  createdAt   DateTime @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, type, targetId]) // one report per user per content item
  @@index([status, createdAt])
}

// ── Social Posts ──────────────────────────────────────────────────────────────

model Post {
  id          String        @id @default(cuid())
  authorId    String
  textContent String?
  images      String        @default("[]")
  visibility  String        @default("public")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes    PostLike[]
  comments PostComment[]

  @@index([authorId, createdAt])
  @@index([createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostComment {
  id        String      @id @default(cuid())
  postId    String
  userId    String
  body      String
  parentId  String?
  createdAt DateTime    @default(now())
  deletedAt DateTime?

  post    Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  PostComment? @relation("PostReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies PostComment[] @relation("PostReplies")

  @@index([postId, createdAt])
}
